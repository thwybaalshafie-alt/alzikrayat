# Express server port
PORT=5000

# MongoDB Atlas or local MongoDB connection string
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/alzikrayat?retryWrites=true&w=majority

# Allowed frontend origin for CORS
CLIENT_ORIGIN=http://localhost:5173

# Bonus Project 4: AI Integration (Z.AI OpenAI-compatible Vision/Chat API)
ZAI_API_KEY=your_zai_api_key_here
ZAI_BASE_URL=https://api.z.ai/api/paas/v4
ZAI_MODEL=glm-4.6v-flash
